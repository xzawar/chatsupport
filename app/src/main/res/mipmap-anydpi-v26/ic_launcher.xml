<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon, generated from the brand tile (yellow field, charcoal line art).
    background: the tile yellow, filling the bleed around the 80dp tile.
    foreground: the tile, centred on the 108dp canvas so every launcher mask keeps the face.
    monochrome: the line art alone, for Android 13+ themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
