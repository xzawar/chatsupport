<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing in this app leaves the device through Android backup or device-to-device transfer.

    allowBackup="false" only governs cloud backup. From Android 12, device-to-device transfer
    ("copy apps from your old phone") ignores it and copies app data unless these rules exclude
    it. That data includes the signed-in session and the cached conversations, which must not be
    carried to another phone: the user signs in again there and the inbox re-syncs from the server.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
